# 复制为 .env 并填入真实 Key（.env 不会提交到 Git）

DEEPSEEK_API_KEY=sk-your-api-key-here

DEEPSEEK_BASE_URL=https://api.deepseek.com



# BGE 中文向量（FlagEmbedding）

EMBED_MODEL=BAAI/bge-small-zh-v1.5



# Cross-Encoder 精排

RERANK_MODEL=BAAI/bge-reranker-base



# RoBERTa 中文情感

SENTIMENT_MODEL=uer/roberta-base-finetuned-jd-binary-chinese



# BERT 中文 NER

NER_MODEL=ckiplab/bert-base-chinese-ner

# BERT 关系抽取（RE）基座模型

RE_BASE_MODEL=hfl/chinese-bert-wwm-ext
RE_CONFIDENCE_THRESHOLD=0.55



# BM25 与 BGE 召回融合权重（BM25 占比，0~1）

HYBRID_BM25_WEIGHT=0.55

# 精排与质量筛选阈值

RERANK_TOP_K=20
RETRIEVAL_MIN_SCORE=0.15
QUALITY_MIN_SCORE=0.45

# LLM 生成参数

LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=500

# Redis 缓存（auto / true / false）

REDIS_ENABLED=auto
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=300

# 垂直领域标识

VERTICAL_DOMAIN=literature_poetry

